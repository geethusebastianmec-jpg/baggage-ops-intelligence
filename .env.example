# ── LLM ─────────────────────────────────────────────────────────────────────
# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# ── Kafka / Redpanda ─────────────────────────────────────────────────────────
# Use localhost:19092 when running agents outside Docker
# Use redpanda:9092 when running inside Docker network
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ── PostgreSQL (LangGraph checkpoint store) ──────────────────────────────────
POSTGRES_DSN=postgresql://baggage:baggage@localhost:5432/baggage_ops

# ── Redis (working memory) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LangSmith observability (optional but recommended) ───────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=baggage-demo

# ── Model selection ──────────────────────────────────────────────────────────
# Tier 1: novel compound disruptions (strongest reasoning, used sparingly)
LLM_TIER1_NOVEL=gemini-1.5-pro
# Tier 1: known playbook pattern matching (fast, cost-efficient)
LLM_TIER1_PLAYBOOK=gemini-2.0-flash
# Tier 2: domain coordinator DAG planning
LLM_TIER2=gemini-2.0-flash

# ── Demo config ──────────────────────────────────────────────────────────────
DEMO_AIRPORT=JFK
# Artificial latency for mock tool calls (ms) — makes demo pacing visible
TOOL_LATENCY_MS=150
# Set to true to inject random tool failures (tests error handling paths)
INJECT_TOOL_FAILURES=false
