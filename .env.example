# ── LLM ─────────────────────────────────────────────────────────────────────
# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# ── Kafka ────────────────────────────────────────────────────────────────────
# LOCAL (Redpanda via docker compose):
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# CLOUD (Redpanda Cloud — replace the values below):
# KAFKA_BOOTSTRAP_SERVERS=seed-xxxx.us-east-1.aws.redpanda.cloud:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# LOCAL:
POSTGRES_DSN=postgresql://baggage:baggage@localhost:5432/baggage_ops
# CLOUD (Railway Postgres plugin — copy the DATABASE_URL it gives you):
# POSTGRES_DSN=postgresql://postgres:xxxx@containers-us-west-xx.railway.app:5432/railway

# ── Redis ────────────────────────────────────────────────────────────────────
# LOCAL:
REDIS_URL=redis://localhost:6379/0
# CLOUD (Railway Redis plugin — copy the REDIS_URL it gives you):
# REDIS_URL=redis://default:xxxx@containers-us-west-xx.railway.app:6379

# ── Service URLs ─────────────────────────────────────────────────────────────
# The dashboard needs to know the API's public URL (set after API is deployed)
API_URL=http://localhost:8000
# CLOUD example:
# API_URL=https://baggage-api.up.railway.app

# ── LangSmith (optional) ─────────────────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=baggage-demo

# ── Model selection ──────────────────────────────────────────────────────────
LLM_TIER1_NOVEL=gemini-1.5-pro
LLM_TIER1_PLAYBOOK=gemini-2.0-flash
LLM_TIER2=gemini-2.0-flash

# ── Demo config ──────────────────────────────────────────────────────────────
DEMO_AIRPORT=JFK
TOOL_LATENCY_MS=100
INJECT_TOOL_FAILURES=false
